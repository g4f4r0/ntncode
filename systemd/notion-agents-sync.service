[Unit]
Description=notion-agents: sync Notion instructions to AGENTS.md files
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/node/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/secrets.env
ExecStart=%h/projects/g4f4r0/notion-agents/bin/notion-agents sync
TimeoutStartSec=300
Nice=10
